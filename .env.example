# Next.js / Clerk. Copy this file to .env.local.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up

# Printed by `npx convex dev` after you link a deployment.
NEXT_PUBLIC_CONVEX_URL=

# Used by docker compose for n8n. Generate both with: openssl rand -hex 32
N8N_ENCRYPTION_KEY=
N8N_WEBHOOK_SECRET=

# https://<your-deployment>.convex.site  (not the .convex.cloud URL)
CONVEX_SITE_URL=
