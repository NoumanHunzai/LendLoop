{
  "name": "LendLoop overdue reminders",
  "nodes": [
    {
      "id": "a2000000-0000-4000-8000-000000000001",
      "name": "Daily at 08:00 UTC",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        240,
        300
      ],
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "cronExpression",
              "expression": "0 8 * * *"
            }
          ]
        }
      }
    },
    {
      "id": "a2000000-0000-4000-8000-000000000002",
      "name": "Sign overdue request",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        480,
        300
      ],
      "parameters": {
        "jsCode": "const crypto = require(\"crypto\");\nconst secret = process.env.N8N_WEBHOOK_SECRET || \"\";\nconst base = String(process.env.CONVEX_SITE_URL || \"\").replace(/[/]$/, \"\");\nif (!secret || !base) throw new Error(\"N8N_WEBHOOK_SECRET and CONVEX_SITE_URL must be set.\");\nconst timestamp = Date.now().toString();\nconst bodyHash = crypto.createHash(\"sha256\").update(\"\", \"utf8\").digest(\"hex\");\nconst canonical = \"v1:\" + timestamp + \":GET:convex/overdue:\" + bodyHash;\nconst signature = crypto.createHmac(\"sha256\", secret).update(canonical, \"utf8\").digest(\"hex\");\nreturn [{ json: { timestamp, signature, url: base + \"/n8n/overdue\" } }];\n"
      }
    },
    {
      "id": "a2000000-0000-4000-8000-000000000003",
      "name": "Fetch overdue loans",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        740,
        300
      ],
      "parameters": {
        "method": "GET",
        "url": "={{ $json.url }}",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "x-lendloop-timestamp",
              "value": "={{ $json.timestamp }}"
            },
            {
              "name": "x-lendloop-signature",
              "value": "={{ $json.signature }}"
            }
          ]
        },
        "options": {
          "timeout": 10000
        }
      },
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 1000
    },
    {
      "id": "a2000000-0000-4000-8000-000000000004",
      "name": "Split loans",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        980,
        300
      ],
      "parameters": {
        "jsCode": "const loans = Array.isArray($json.loans) ? $json.loans : [];\nreturn loans\n  .filter((loan) => loan && loan.loanId)\n  .map((loan) => ({ json: { loanId: loan.loanId, toolName: loan.toolName, endDate: loan.endDate } }));\n"
      }
    },
    {
      "id": "a2000000-0000-4000-8000-000000000005",
      "name": "Sign reminder",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1200,
        300
      ],
      "parameters": {
        "jsCode": "const crypto = require(\"crypto\");\nconst secret = process.env.N8N_WEBHOOK_SECRET || \"\";\nconst base = String(process.env.CONVEX_SITE_URL || \"\").replace(/[/]$/, \"\");\nif (!secret || !base) throw new Error(\"N8N_WEBHOOK_SECRET and CONVEX_SITE_URL must be set.\");\nconst raw = JSON.stringify({ loanId: $json.loanId });\nconst timestamp = Date.now().toString();\nconst bodyHash = crypto.createHash(\"sha256\").update(raw, \"utf8\").digest(\"hex\");\nconst canonical = \"v1:\" + timestamp + \":POST:convex/reminders:\" + bodyHash;\nconst signature = crypto.createHmac(\"sha256\", secret).update(canonical, \"utf8\").digest(\"hex\");\nreturn [{ json: { timestamp, signature, raw, url: base + \"/n8n/reminders\" } }];\n"
      }
    },
    {
      "id": "a2000000-0000-4000-8000-000000000006",
      "name": "Write reminder",
